# PostgreSQL connection used by OpsManager.Api.
ConnectionStrings__OpsManager=Host=localhost;Port=5432;Database=opsmanager;Username=opsmanager;Password=1q2w!Q@W123xxx123

# Development seed is opt-in. Use a local secret with at least 12 characters.
Seed__Enabled=false
Seed__Password=

# Production must provide a random secret of at least 32 UTF-8 bytes.
Jwt__Issuer=OpsManager
Jwt__Audience=OpsManager.Client
Jwt__SigningKey=replace-with-a-random-secret-from-your-secret-store
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

RefreshCookie__Secure=true
RefreshCookie__SameSite=Strict
Onboarding__DefaultPlanCode=development-standard
Onboarding__TrialDays=14
Scheduler__Enabled=true
Scheduler__IntervalMinutes=60
Scheduler__GenerationHorizonDays=30

# Origins are exact: scheme, hostname, and port must match the browser URL.
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://127.0.0.1:3000
