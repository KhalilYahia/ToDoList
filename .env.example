# PostgreSQL connection used by OpsManager.Api.
ConnectionStrings__OpsManager=Host=localhost;Port=5432;Database=opsmanager;Username=opsmanager;Password=change-me

# Development seed is opt-in. Use a local secret with at least 12 characters.
Seed__Enabled=false
Seed__Password=

# Semicolon-delimited environment overrides can be represented by indexed keys.
Cors__AllowedOrigins__0=http://localhost:3000
